{
  "name": "marlinraker",
  "version": "v0.2.3-alpha",
  "main": "src/Server.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development MARLINRAKER_DIR=./marlinraker_files/ tsx src/Server.ts --serve-static --extended-logs",
    "dev.api": "cross-env NODE_ENV=development MARLINRAKER_DIR=./marlinraker_files/ tsx src/Server.ts --extended-logs",
    "build": "node scripts/build.mjs",
    "build.zip": "node scripts/build.mjs --zip",
    "lint": "eslint src test --max-warnings=0 --fix",
    "typecheck": "tsc --noEmit",
    "test": "eslint src test --max-warnings=0 && tsc --noEmit && npm run test.unit",
    "test.unit": "node --import tsx --test \"test/**/*.test.ts\"",
    "docs.serve": "mkdocs serve"
  },
  "author": "pauhull",
  "license": "GPLv3",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "node-json-db": "^2.1.4",
    "rfc4648": "^1.5.2",
    "rotating-file-stream": "^3.2.10",
    "serialport": "^10.5.0",
    "smol-toml": "^1.9.1",
    "tslib": "^2.5.0",
    "unzipper": "^0.10.11",
    "ws": "^8.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/unzipper": "^0.10.5",
    "@types/ws": "^8.5.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^2.0.0",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.7",
    "utf-8-validate": "^5.0.10"
  }
}
